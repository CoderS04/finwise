# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/finwise_db

# ============================================
# JWT & SECURITY
# ============================================
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=15

# ============================================
# LLM PROVIDER CONFIGURATION
# ============================================

# LOCAL DEVELOPMENT (Ollama)
# Set LLM_PROVIDER=ollama to use local Ollama service
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=neural-chat

# PRODUCTION (OpenAI)
# Set LLM_PROVIDER=openai to use OpenAI API
# Uncomment and set your OpenAI API key for production
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-api-key-here

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=10

# ============================================
# APPLICATION SETTINGS
# ============================================
DEBUG=false
ENVIRONMENT=development
