APP_NAME=Finwise
# ⚠️ IMPORTANT: Change these values in production!
SECRET_KEY=your-production-secret-key-must-be-32-chars-minimum-and-cryptographically-secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database Configuration - Use production database
# Connect to managed database service (e.g., AWS RDS, Render, Railway)
DATABASE_URL=postgresql://username:password@db-host:5432/finwise

# CORS Configuration - Only allow your actual production domain
ALLOWED_ORIGINS=https://finwise.com,https://app.finwise.com,https://www.finwise.com

# Environment flag
ENVIRONMENT=production
